{
  "name": "dsh-skill-eval",
  "version": "1.25.1",
  "description": "Skill execution telemetry & effectiveness scoring for DeepSeek Harness: records every skill load, folds the follow-up window into evidence, scores each skill and hands the agent concrete optimization advice.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "icon.svg",
  "scripts": {
    "compile": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/client && tsc -p test",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "build:fast": "tsc -p tsconfig.json && node scripts/build.mjs --fast",
    "build:pack": "tsc -p tsconfig.json && node scripts/build.mjs --pack",
    "build:install": "tsc -p tsconfig.json && node scripts/build.mjs --install",
    "build:client": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "accept": "node scripts/accept.mjs",
    "verify": "node scripts/verify-live.mjs",
    "doctor": "node scripts/doctor.mjs",
    "release:check": "npm run compile && npm run format:check && npm run lint && npm run typecheck && node scripts/doctor.mjs --release && node --experimental-strip-types --test \"test/**/*.test.ts\" && node scripts/accept.mjs",
    "release:pack": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && npm pack --pack-destination dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "e2e": "node tools/e2e-live.mjs",
    "pree2e": "npm run compile"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs/*.md",
    "README.md",
    "README.zh.md",
    "scripts/*.mjs",
    "!scripts/build-client.mjs",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlslin/dsh-skill-eval.git"
  },
  "homepage": "https://github.com/carlslin/dsh-skill-eval#readme",
  "bugs": {
    "url": "https://github.com/carlslin/dsh-skill-eval/issues"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "bin": {
    "dsh-skill-eval-verify": "scripts/verify-live.mjs",
    "dsh-skill-eval-doctor": "scripts/doctor.mjs",
    "dsh-skill-eval-accept": "scripts/accept.mjs",
    "dsh-skill-eval-export": "scripts/export.mjs"
  },
  "author": "dsh-skill-eval contributors",
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "skills",
    "telemetry",
    "evaluation",
    "scoring"
  ]
}
